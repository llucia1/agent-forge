# This file is copied to .env.litellm and is loaded only by the LiteLLM service.
# Never place these provider credentials in AgentForge's .env file.

LITELLM_ARCHITECT_MODEL=ollama/qwen2.5-coder:7b
LITELLM_GENERAL_MODEL=ollama/qwen2.5-coder:7b
OLLAMA_BASE_URL=http://ollama:11434
LITELLM_MASTER_KEY=change_me_gateway_key
